{
  "name": "@monotykamary/varve",
  "version": "0.1.0",
  "description": "TypeScript client for the Varve time-series database",
  "type": "module",
  "license": "Apache-2.0",
  "author": "Kamary",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/monotykamary/varve.git",
    "directory": "clients/typescript"
  },
  "homepage": "https://github.com/monotykamary/varve#readme",
  "bugs": {
    "url": "https://github.com/monotykamary/varve/issues"
  },
  "keywords": ["varve", "timeseries", "database", "websocket"],
  "engines": { "node": ">=22" },
  "exports": {
    ".": {
      "types": "./dist/src/index.d.ts",
      "import": "./dist/src/index.js"
    }
  },
  "types": "./dist/src/index.d.ts",
  "files": ["dist/src", "README.md", "LICENSE"],
  "publishConfig": { "access": "public" },
  "scripts": {
    "clean": "node -e \"require('node:fs').rmSync('dist',{recursive:true,force:true})\"",
    "typecheck": "tsc --noEmit",
    "build": "npm run clean && tsc -p tsconfig.json",
    "test": "npm run build && node --test dist/test/client.test.js",
    "test:integration": "npm run build && node --test dist/test/integration.test.js",
    "pack:check": "npm pack --dry-run",
    "prepack": "npm run build"
  },
  "dependencies": { "lossless-json": "4.3.1" },
  "devDependencies": {
    "@types/node": "22.15.3",
    "typescript": "5.8.3"
  }
}
