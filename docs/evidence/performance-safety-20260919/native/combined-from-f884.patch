+fn engine_config(library: std::path::PathBuf) -> crate::Config {
+    crate::Config {
+        duckdb_library: Some(library),
+        query_native_reuse: true,
+        query_executable: "/no-cli-fallback-permitted".into(),
+        decoded_cache_bytes: 0,
+        ..crate::Config::default()
+    }
