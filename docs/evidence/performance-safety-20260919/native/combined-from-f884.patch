+fn logical_owner_drop_releases_lock_despite_live_child_descriptor() {
+    use std::io::{Read, Write};
+    use std::os::fd::OwnedFd;
+    use std::os::unix::net::UnixStream;
+    use std::process::{Child, Stdio};
+    use std::time::Duration;
+
+    struct ReapChild(Child);
+    impl Drop for ReapChild {
+        fn drop(&mut self) {
+            let _ = self.0.kill();
+            let _ = self.0.wait();
+        }
+    }
+
+    let dir = fixture();
+    let mut journal = Journal::open(dir.path(), config()).unwrap();
+    assert_eq!(
+        journal.append_group(&[b"before"]).unwrap().first_sequence(),
+        1
+    );
+    assert!(journal.active.is_some());
+    let (mut control, child_control) = UnixStream::pair().unwrap();
+    control
+        .set_read_timeout(Some(Duration::from_secs(10)))
+        .unwrap();
+    control
+        .set_write_timeout(Some(Duration::from_secs(10)))
+        .unwrap();
+    // stdin keeps the journal's open-file description alive in a real child.
+    // The duplex stderr socket gates its lifetime without sleeps or unsafe code.
+    let mut child = ReapChild(
+        Command::new("sh")
+            .args([
+                "-c",
+                "printf R >&2; IFS= read -r release <&2; test \"$release\" = release",
+            ])
+            .stdin(Stdio::from(journal._lock.try_clone().unwrap()))
+            .stdout(Stdio::null())
+            .stderr(Stdio::from(OwnedFd::from(child_control)))
+            .spawn()
+            .unwrap(),
+    );
+    let mut ready = [0];
+    control.read_exact(&mut ready).unwrap();
+    assert_eq!(ready, *b"R");
+    assert!(child.0.try_wait().unwrap().is_none());
+    let error = Journal::open(dir.path(), config())
+        .err()
+        .expect("live owner excluded");
+    assert!(error.to_string().contains("already owned"), "{error:#}");
+    let before_drop = snapshot(dir.path());
+    drop(journal);
+    assert_eq!(snapshot(dir.path()), before_drop);
+
+    let mut successor = Journal::open(dir.path(), config())
+        .expect("logical owner drop must release the lock while the child retains stdin");
+    assert!(child.0.try_wait().unwrap().is_none());
+    assert_eq!(replay(&successor), vec![vec![(1, b"before".to_vec())]]);
+    assert_eq!(
