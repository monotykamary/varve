+    control.write_all(b"release\n").unwrap();
+    let mut remaining = Vec::new();
+    control.read_to_end(&mut remaining).unwrap();
+    assert!(remaining.is_empty());
+    assert!(child.0.wait().unwrap().success());
+    let error = Journal::open(dir.path(), config())
