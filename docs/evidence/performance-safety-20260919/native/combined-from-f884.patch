+            .execute(
+                &tables,
+                Some(&snapshot),
+                "SELECT value FROM metrics",
+                &options,
+                &catalog,
+                &budget,
+                &cancelled,
+            )
+            .unwrap_err();
+        assert!(
+            format!("{error:#}").contains("cancelled"),
+            "phase {phase}: {error:#}"
+        );
+        assert_eq!(runtime.stats().idle, 0);
+        assert_eq!(runtime.live_callback_owners(), 0);
+        assert_eq!(budget.status().reserved_bytes, 0);
